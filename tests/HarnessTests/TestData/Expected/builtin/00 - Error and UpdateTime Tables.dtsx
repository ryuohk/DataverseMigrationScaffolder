<DTS:Executables><DTS:Executable DTS:refId="Package\Create Error Table" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{5C9566DA-517D-5506-9C6A-DC11A563EA8C}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="Create Error Table" DTS:ThreadHint="0"><DTS:Variables/><DTS:ObjectData><SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{B8417766-EC9D-4BA9-B311-D190769147F3}" SQLTask:SqlStatementSource="SET ANSI_NULLS ON;&#xA;SET QUOTED_IDENTIFIER ON;&#xA;&#xA;IF OBJECT_ID(N'[dbo].[Error]', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[Error](&#xA;        [ErrorTimeUtc] DATETIME2(7) NOT NULL CONSTRAINT [DF_Error_ErrorTimeUtc] DEFAULT (SYSUTCDATETIME()),&#xA;        [ErrorCode] VARCHAR(100) NULL,&#xA;        [ErrorMessage] NVARCHAR(MAX) NULL,&#xA;        [tablename] NVARCHAR(100) NULL&#xA;    );&#xA;END&#xA;"/></DTS:ObjectData></DTS:Executable><DTS:Executable DTS:refId="Package\Create UpdateTime Table" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{30413AC0-ADEC-5A08-9CB3-AB3B276A2CC1}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="Create UpdateTime Table" DTS:ThreadHint="0"><DTS:Variables/><DTS:ObjectData><SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{B8417766-EC9D-4BA9-B311-D190769147F3}" SQLTask:SqlStatementSource="SET ANSI_NULLS ON;&#xA;SET QUOTED_IDENTIFIER ON;&#xA;&#xA;IF OBJECT_ID(N'[dbo].[UpdateTime]', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[UpdateTime](&#xA;        [DeltaDate] DATETIME2(7) NOT NULL,&#xA;        [rowid] TINYINT NULL&#xA;    );&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM [dbo].[UpdateTime] WHERE [rowid] = 1)&#xA;BEGIN&#xA;    INSERT INTO [dbo].[UpdateTime] ([DeltaDate], [rowid])&#xA;    VALUES (CONVERT(datetime2(7), '1753-01-01T00:00:00.0000000'), 1);&#xA;END&#xA;"/></DTS:ObjectData></DTS:Executable><DTS:Executable DTS:refId="Package\Create GUID Tables" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{6994C7F5-A74A-5B89-9301-5F1C050A374F}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="Create GUID Tables" DTS:ThreadHint="0"><DTS:Variables/><DTS:ObjectData><SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{B8417766-EC9D-4BA9-B311-D190769147F3}" SQLTask:SqlStatementSource="/*&#xA; * GUID mapping tables - file 1 of 3&#xA; * Generated by Dataverse Migration Scaffolder (test fixture)&#xA; */&#xA;&#xA;IF OBJECT_ID(N'[dbo].[guid_contoso_Category]', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[guid_contoso_Category](&#xA;        [contoso_categoryid] VARCHAR(100) NULL,&#xA;        [contoso_category] NVARCHAR(100) NULL,&#xA;        [contoso_legacyid] NVARCHAR(100) NULL&#xA;    );&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE [name] = N'IX_guid_contoso_Category_contoso_legacyid' AND [object_id] = OBJECT_ID(N'[dbo].[guid_contoso_Category]'))&#xA;    CREATE NONCLUSTERED INDEX [IX_guid_contoso_Category_contoso_legacyid] ON [dbo].[guid_contoso_Category]([contoso_legacyid]);&#xA;&#xA;IF OBJECT_ID(N'[dbo].[guid_contoso_Court]', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[guid_contoso_Court](&#xA;        [contoso_courtid] VARCHAR(100) NULL,&#xA;        [contoso_name] NVARCHAR(100) NULL&#xA;    );&#xA;END&#xA;&#xA;/*&#xA; * GUID mapping tables - file 2 of 3&#xA; * Generated by Dataverse Migration Scaffolder (test fixture)&#xA; */&#xA;&#xA;IF OBJECT_ID(N'[dbo].[guid_contoso_Case]', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[guid_contoso_Case](&#xA;        [contoso_caseid] VARCHAR(100) NULL,&#xA;        [contoso_categoryid] NVARCHAR(100) NULL,&#xA;        [contoso_courtid] NVARCHAR(100) NULL,&#xA;        [contoso_incidentid] NVARCHAR(100) NULL,&#xA;        [contoso_legacyid] NVARCHAR(100) NULL,&#xA;        [contoso_name] NVARCHAR(200) NULL&#xA;    );&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE [name] = N'IX_guid_contoso_Case_contoso_legacyid' AND [object_id] = OBJECT_ID(N'[dbo].[guid_contoso_Case]'))&#xA;    CREATE NONCLUSTERED INDEX [IX_guid_contoso_Case_contoso_legacyid] ON [dbo].[guid_contoso_Case]([contoso_legacyid]);&#xA;&#xA;/*&#xA; * GUID mapping tables - file 3 of 3&#xA; * Generated by Dataverse Migration Scaffolder (test fixture)&#xA; */&#xA;&#xA;IF OBJECT_ID(N'[dbo].[guid_contoso_Incident]', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[guid_contoso_Incident](&#xA;        [contoso_incidentid] VARCHAR(100) NULL,&#xA;        [contoso_caseid] NVARCHAR(100) NULL,&#xA;        [contoso_legacyid] NVARCHAR(100) NULL,&#xA;        [contoso_name] NVARCHAR(100) NULL&#xA;    );&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE [name] = N'IX_guid_contoso_Incident_contoso_legacyid' AND [object_id] = OBJECT_ID(N'[dbo].[guid_contoso_Incident]'))&#xA;    CREATE NONCLUSTERED INDEX [IX_guid_contoso_Incident_contoso_legacyid] ON [dbo].[guid_contoso_Incident]([contoso_legacyid]);&#xA;"/></DTS:ObjectData></DTS:Executable></DTS:Executables><DTS:PrecedenceConstraints><DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Constraint 1]" DTS:CreationName="" DTS:DTSID="{21770972-046E-5D11-B1A8-2CBAF595EDE5}" DTS:From="Package\Create Error Table" DTS:LogicalAnd="True" DTS:ObjectName="Constraint 1" DTS:To="Package\Create UpdateTime Table"/><DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Constraint 2]" DTS:CreationName="" DTS:DTSID="{DEDFDDBF-ECE7-590C-8D1A-AF37684875D1}" DTS:From="Package\Create UpdateTime Table" DTS:LogicalAnd="True" DTS:ObjectName="Constraint 2" DTS:To="Package\Create GUID Tables"/></DTS:PrecedenceConstraints><DTS:DesignTimeProperties><![CDATA[<Objects Version="8"><Package design-time-name="Package"><LayoutInfo><GraphLayout xmlns="clr-namespace:Microsoft.SqlServer.IntegrationServices.Designer.Model.Serialization;assembly=Microsoft.SqlServer.IntegrationServices.Graph" Capacity="4"><NodeLayout Size="204,42" Id="Package\Create Error Table" TopLeft="40,30"/><NodeLayout Size="244,42" Id="Package\Create UpdateTime Table" TopLeft="40,120"/><NodeLayout Size="204,42" Id="Package\Create GUID Tables" TopLeft="40,210"/></GraphLayout></LayoutInfo></Package></Objects>]]></DTS:DesignTimeProperties></DTS:Executable>