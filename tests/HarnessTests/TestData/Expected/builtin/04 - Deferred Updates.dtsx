                <connection refId="Package\Update Case Lookups\OLE DB Source - Staging.Connections[OleDbConnection]" connectionManagerID="{B8417766-EC9D-4BA9-B311-D190769147F3}:external" connectionManagerRefId="Project.ConnectionManagers[Staging]" description="The OLE DB runtime connection used to access the database." name="OleDbConnection"/>
              </connections>
