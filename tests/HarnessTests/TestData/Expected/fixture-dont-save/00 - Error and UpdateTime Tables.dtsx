<?xml version="1.0" encoding="utf-8"?><DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" DTS:refId="Package" DTS:CreationDate="1/14/2026 9:46:58 PM" DTS:CreationName="Microsoft.Package" DTS:CreatorComputerName="EXAMPLE-SQL" DTS:CreatorName="EXAMPLE\user" DTS:DTSID="{9CD82367-3CF3-5DB6-ACE3-D21325AE8B17}" DTS:ExecutableType="Microsoft.Package" DTS:LastModifiedProductVersion="17.0.1010.2" DTS:LocaleID="1033" DTS:ObjectName="00 - Error and UpdateTime Tables" DTS:PackageType="5" DTS:VersionBuild="310" DTS:VersionGUID="{DA9EA07F-B708-5311-B4D5-89336CDBDD45}" DTS:ProtectionLevel="0">
