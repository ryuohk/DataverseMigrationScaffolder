<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regression tests for the SSIS project generator (DataverseMigrationScaffolder/Harness):
       every scenario in TestData/scenarios.json is generated and compared byte for byte with
       TestData/Expected. The expected output was recorded from the original Python generator
       (migration-harness-generator, now retired). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../DataverseMigrationScaffolder/Harness/*.cs" LinkBase="Harness" />
  </ItemGroup>
</Project>
